<%
  const page = 'skills';
  const pageTitle = 'Skills';
  const pageDescription = 'Technical skills of Bokhtear Md Abid, a full-stack and AI developer: Python, Django, React Native, Node.js, Express, MongoDB, PostgreSQL and the Gemini API.';
  const s = data.skills || {};
  const list = (key) => Array.isArray(s[key]) ? s[key] : [];
%>
<%- include('header') %>
<link rel="stylesheet" href="/css/kinetic-grid.css">
<canvas id="kinetic-grid" data-theme="monochrome" aria-hidden="true"></canvas>

<!-- Skills Section -->
<section class="section pt-24">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <h1 class="section-title">Technical <span class="gradient-text">Skills</span></h1>
    <p class="text-gray-light mt-4 mb-12 max-w-3xl text-lg">
      Technical skills of Bokhtear Md Abid: full-stack and AI development with Python, Django, React Native, Node.js and the Gemini API.
    </p>

    <!-- Programming Languages -->
    <div class="mb-16">
      <div class="flex items-center mb-8">
        <i class="fas fa-code text-4xl text-maroon-light mr-4"></i>
        <h2 class="text-3xl font-bold">Programming Languages</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <% list('languages').forEach((skill, index) => { %>
          <div class="skill-item stagger-in" style="animation-delay: <%= index * 0.05 %>s;">
            <div class="flex items-center justify-between">
              <span class="font-semibold text-lg"><%= skill %></span>
              <i class="fas fa-chevron-right text-maroon-light"></i>
            </div>
          </div>
        <% }); %>
      </div>
    </div>

    <!-- Frameworks & Libraries -->
    <div class="mb-16">
      <div class="flex items-center mb-8">
        <i class="fas fa-layer-group text-4xl text-maroon-light mr-4"></i>
        <h2 class="text-3xl font-bold">Frameworks &amp; Libraries</h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-6">
        <% list('frameworks').forEach((skill, index) => { %>
          <div class="card stagger-in text-center" style="animation-delay: <%= index * 0.05 %>s;">
            <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-maroon-dark flex items-center justify-center">
              <i class="fas fa-cube text-2xl text-maroon-light"></i>
            </div>
            <h3 class="font-semibold text-lg"><%= skill %></h3>
          </div>
        <% }); %>
      </div>
    </div>

    <!-- AI & LLM -->
    <div class="mb-16">
      <div class="flex items-center mb-8">
        <i class="fas fa-robot text-4xl text-maroon-light mr-4"></i>
        <h2 class="text-3xl font-bold">AI &amp; LLM</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <% list('aiAndLLM').forEach((skill, index) => { %>
          <div class="card stagger-in" style="animation-delay: <%= index * 0.05 %>s;">
            <div class="flex items-center">
              <div class="w-12 h-12 rounded-lg bg-maroon-dark flex items-center justify-center mr-4 shrink-0">
                <i class="fas fa-brain text-maroon-light"></i>
              </div>
              <h3 class="font-semibold text-lg"><%= skill %></h3>
            </div>
          </div>
        <% }); %>
      </div>
    </div>

    <!-- Software Engineering -->
    <div class="mb-16">
      <div class="flex items-center mb-8">
        <i class="fas fa-cogs text-4xl text-maroon-light mr-4"></i>
        <h2 class="text-3xl font-bold">Software Engineering</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <% list('softwareEngineering').forEach((skill, index) => { %>
          <div class="card stagger-in" style="animation-delay: <%= index * 0.05 %>s;">
            <div class="flex items-center">
              <div class="w-12 h-12 rounded-lg bg-maroon-dark flex items-center justify-center mr-4 shrink-0">
                <i class="fas fa-check text-maroon-light"></i>
              </div>
              <div>
                <h3 class="font-semibold text-lg"><%= skill %></h3>
                <% if (skill === 'OOP') { %>
                  <p class="text-gray-light text-sm">Object-Oriented Programming</p>
                <% } else if (skill === 'SDLC') { %>
                  <p class="text-gray-light text-sm">Software Development Life Cycle</p>
                <% } %>
              </div>
            </div>
          </div>
        <% }); %>
      </div>
    </div>

    <!-- Data Management -->
    <div class="mb-16">
      <div class="flex items-center mb-8">
        <i class="fas fa-database text-4xl text-maroon-light mr-4"></i>
        <h2 class="text-3xl font-bold">Databases &amp; Data</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <% list('dataManagement').forEach((skill, index) => { %>
          <div class="skill-item stagger-in" style="animation-delay: <%= index * 0.05 %>s;">
            <div class="flex items-center justify-between">
              <span class="font-semibold text-lg"><%= skill %></span>
              <i class="fas fa-database text-maroon-light"></i>
            </div>
          </div>
        <% }); %>
      </div>
    </div>

    <!-- Version Control -->
    <div class="mb-16">
      <div class="flex items-center mb-8">
        <i class="fab fa-git-alt text-4xl text-maroon-light mr-4"></i>
        <h2 class="text-3xl font-bold">Version Control</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <% list('versionControl').forEach((skill, index) => { %>
          <div class="card stagger-in" style="animation-delay: <%= index * 0.05 %>s;">
            <div class="flex items-center">
              <div class="w-12 h-12 rounded-lg bg-maroon-dark flex items-center justify-center mr-4 shrink-0">
                <i class="fab fa-github text-maroon-light text-2xl"></i>
              </div>
              <h3 class="font-semibold text-lg"><%= skill %></h3>
            </div>
          </div>
        <% }); %>
      </div>
    </div>

    <!-- Deployment & DevOps -->
    <div class="mb-16">
      <div class="flex items-center mb-8">
        <i class="fas fa-cloud-upload-alt text-4xl text-maroon-light mr-4"></i>
        <h2 class="text-3xl font-bold">Deployment &amp; DevOps</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <% list('deployment').forEach((skill, index) => { %>
          <div class="skill-item stagger-in" style="animation-delay: <%= index * 0.05 %>s;">
            <div class="flex items-center justify-between">
              <span class="font-semibold text-lg"><%= skill %></span>
              <i class="fas fa-server text-maroon-light"></i>
            </div>
          </div>
        <% }); %>
      </div>
    </div>

    <!-- API & Connectivity -->
    <div class="mb-16">
      <div class="flex items-center mb-8">
        <i class="fas fa-plug text-4xl text-maroon-light mr-4"></i>
        <h2 class="text-3xl font-bold">APIs &amp; Integrations</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <% list('connectivity').forEach((skill, index) => { %>
          <div class="card stagger-in" style="animation-delay: <%= index * 0.05 %>s;">
            <div class="flex items-center">
              <div class="w-12 h-12 rounded-lg bg-maroon-dark flex items-center justify-center mr-4 shrink-0">
                <i class="fas fa-exchange-alt text-maroon-light"></i>
              </div>
              <h3 class="font-semibold text-lg"><%= skill %></h3>
            </div>
          </div>
        <% }); %>
      </div>
    </div>

    <!-- Skill Summary Card -->
    <div class="mt-16">
      <div class="card bg-gradient-to-br from-maroon-dark to-black">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
          <div>
            <div class="text-5xl font-bold gradient-text mb-2"><%= list('languages').length %></div>
            <p class="text-gray-light">Programming Languages</p>
          </div>
          <div>
            <div class="text-5xl font-bold gradient-text mb-2"><%= list('frameworks').length %></div>
            <p class="text-gray-light">Frameworks &amp; Tools</p>
          </div>
          <div>
            <div class="text-5xl font-bold gradient-text mb-2"><%= list('aiAndLLM').length %></div>
            <p class="text-gray-light">AI &amp; LLM Skills</p>
          </div>
          <div>
            <div class="text-5xl font-bold gradient-text mb-2"><%= Object.keys(s).length %></div>
            <p class="text-gray-light">Skill Categories</p>
          </div>
        </div>
      </div>
    </div>

    <!-- CTA -->
    <div class="mt-12 text-center">
      <p class="text-gray-light text-lg mb-4">Want to see these skills in action?</p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/projects" class="btn-primary">View Projects</a>
        <a href="/contact" class="btn-primary" style="background: transparent; border: 2px solid var(--maroon);">Get In Touch</a>
      </div>
    </div>
  </div>
</section>

<script src="/js/kinetic-grid.js" defer></script>
<%- include('footer') %>
