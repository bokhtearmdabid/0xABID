<% const page = 'research'; const pageTitle = 'Research'; %>
<%- include('header') %>

<link rel="stylesheet" href="/css/kinetic-grid.css">
<canvas id="kinetic-grid" data-theme="monochrome"></canvas>

<%
  const all = data.research || [];

  const sections = [
    {
      title: 'Published',
      icon: 'fa-circle-check',
      items: all.filter(r => r.status === 'published'),
      empty: 'No published papers yet.',
      spacing: 'mb-16'
    },
    {
      title: 'Ongoing',
      icon: 'fa-flask',
      items: all.filter(r => r.status === 'ongoing'),
      empty: 'No ongoing research listed right now.',
      spacing: ''
    }
  ];

  const getDoiUrl = (doi) => {
    if (!doi || !doi.trim()) return '';
    return doi.startsWith('http') ? doi : 'https://doi.org/' + doi.trim();
  };

  const renderCard = (paper, index) => {
    const isPublished = paper.status === 'published';
    const doiUrl = getDoiUrl(paper.doi);
    const message = paper.note
      || (isPublished ? 'Paper link coming soon.' : 'This research is ongoing and not published yet.');
%>
    <div class="card flex flex-col" style="animation-delay: <%= index * 0.1 %>s;">

      <div class="flex items-center justify-between mb-4">
        <span class="px-3 py-1 text-xs font-semibold rounded-full border border-maroon/50 text-maroon-light">
          <%= isPublished ? 'Published' : 'Ongoing' %>
        </span>
        <span class="text-sm text-gray-light"><%= paper.year %></span>
      </div>

      <h3 class="text-2xl lg:text-3xl font-bold mb-3"><%= paper.title %></h3>
      <p class="text-sm text-gray-light mb-1"><i class="fas fa-users mr-2 text-maroon-light"></i><%= paper.authors %></p>
      <p class="text-sm text-gray-light mb-4"><i class="fas fa-book mr-2 text-maroon-light"></i><%= paper.venue %></p>

      <p class="text-gray-light leading-relaxed mb-5"><%= paper.abstract %></p>

      <% if (paper.tags && paper.tags.length) { %>
        <div class="flex flex-wrap gap-2 mb-6">
          <% paper.tags.forEach(tag => { %>
            <span class="px-3 py-1 bg-gray-dark border border-maroon/30 rounded-full text-xs"><%= tag %></span>
          <% }); %>
        </div>
      <% } %>

      <div class="mt-auto">
        <% if (doiUrl) { %>
          <a href="<%= doiUrl %>" target="_blank" rel="noopener noreferrer" class="btn-primary text-sm px-4 py-2">
            <i class="fas fa-external-link-alt mr-2"></i> View Paper
          </a>
        <% } else { %>
          <button type="button" class="btn-primary text-sm px-4 py-2 research-btn" data-msg="<%= message %>">
            <i class="fas fa-eye mr-2"></i> View
          </button>
        <% } %>
      </div>
    </div>
<% }; %>

<section class="section pt-24">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <h1 class="section-title">My <span class="gradient-text">Research</span></h1>
    <p class="text-gray-light mt-4 mb-12 max-w-3xl text-lg">
      My published papers and the research I am currently working on.
    </p>

    <% sections.forEach(section => { %>
      <h2 class="text-2xl font-bold mb-6">
        <i class="fas <%= section.icon %> text-maroon-light mr-2"></i> <%= section.title %>
      </h2>
      <div class="grid grid-cols-1 <%= section.items.length > 1 ? 'lg:grid-cols-2' : '' %> gap-8 <%= section.spacing %>">
        <% section.items.forEach((paper, index) => { renderCard(paper, index); }); %>
        <% if (section.items.length === 0) { %>
          <p class="text-gray-light"><%= section.empty %></p>
        <% } %>
      </div>
    <% }); %>

    <!-- Contact CTA -->
    <div class="mt-16 text-center">
      <p class="text-gray-light text-lg mb-4">Interested in research collaboration?</p>
      <a href="/contact" class="btn-primary">Let's Talk</a>
    </div>
  </div>
</section>

<!-- Message popup -->
<div id="research-toast" role="status" aria-live="polite"></div>

<style>
  #research-toast {
    position: fixed; bottom: 100px; left: 50%;
    transform: translateX(-50%) translateY(20px);
    background: #1a1a1a; color: #fff;
    border: 1px solid #800000; border-radius: 10px;
    padding: 12px 20px; font-size: 14px; z-index: 2000;
    box-shadow: 0 6px 24px rgba(0, 0, 0, .6);
    opacity: 0; pointer-events: none; max-width: calc(100vw - 32px);
    transition: opacity .25s, transform .25s;
  }
  #research-toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }
</style>

<script>
  (function () {
    const toast = document.getElementById('research-toast');
    let timer;
    document.querySelectorAll('.research-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        toast.textContent = btn.dataset.msg;
        toast.classList.add('show');
        clearTimeout(timer);
        timer = setTimeout(() => toast.classList.remove('show'), 2500);
      });
    });
  })();
</script>

<script src="/js/kinetic-grid.js" defer></script>

<%- include('footer') %>