<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof pageTitle !== 'undefined' ? pageTitle + ' | Bokhtear Md Abid' : 'Bokhtear Md Abid | Full-Stack Developer' %></title>
  <meta name="description" content="<%= typeof pageDescription !== 'undefined' ? pageDescription : 'Bokhtear Md Abid is a full-stack developer and CSE graduate from Dhaka, Bangladesh, building web and mobile apps with Django, Node.js & React Native.' %>">
  <link rel="canonical" href="https://bokhtearmdabid.vercel.app<%= typeof page !== 'undefined' && page !== 'home' ? '/' + page : '/' %>">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Bokhtear Md Abid">
  <meta property="og:title" content="<%= typeof pageTitle !== 'undefined' ? pageTitle + ' | Bokhtear Md Abid' : 'Bokhtear Md Abid | Full-Stack Developer' %>">
  <meta property="og:description" content="Full-stack developer from Dhaka, Bangladesh.">
  <meta property="og:image" content="https://bokhtearmdabid.vercel.app/images/profile.jpg">
  <meta property="og:url" content="https://bokhtearmdabid.vercel.app<%= typeof page !== 'undefined' && page !== 'home' ? '/' + page : '/' %>">
  <meta name="twitter:card" content="summary_large_image">
  <link rel="icon" type="image/x-icon" href="/images/favicon.ico">
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  
  <!-- Custom CSS -->
  <link rel="stylesheet" href="/css/style.css">
  
  <!-- Font Awesome -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <% if (typeof page !== 'undefined' && page === 'home') { %>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Person",
    "name": "Bokhtear Md Abid",
    "alternateName": ["Bokhtear Md. Abid", "Abid", "0xABID", "abix404"],
    "url": "https://bokhtearmdabid.vercel.app/",
    "image": "https://bokhtearmdabid.vercel.app/images/profile.jpg",
    "jobTitle": "Full-Stack & AI Developer",
    "address": { "@type": "PostalAddress", "addressLocality": "Dhaka", "addressCountry": "BD" },
    "alumniOf": { "@type": "CollegeOrUniversity", "name": "University of Asia Pacific" },
    "sameAs": [
      "https://linkedin.com/in/bokhtear-md-abid",
      "https://github.com/bokhtearmdabid",
      "https://instagram.com/abix404"
    ]
  }
  </script>
  <% } %>
</head>
<body>
  <!-- Navbar -->
  <nav class="navbar">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex justify-between items-center h-16">
        <!-- Logo -->
            <div class="flex-shrink-0">
              <a href="/" class="flex items-center gap-3">
                <img src="/images/logo.jpg" alt="0xABID" class="h-8 w-auto">
                <span class="text-xl font-bold text-#fff0f2 rgb-glow" style="font-family: 'Playfair Display', serif;">ABID</span>
              </a>
            </div>
        
        <!-- Desktop Navigation -->
        <div class="hidden md:flex space-x-1">
          <a href="/" class="nav-link <%= typeof page !== 'undefined' && page === 'home' ? 'active' : '' %>">Home</a>
          <a href="/about" class="nav-link <%= typeof page !== 'undefined' && page === 'about' ? 'active' : '' %>">About</a>
          <a href="/projects" class="nav-link <%= typeof page !== 'undefined' && page === 'projects' ? 'active' : '' %>">Projects</a>
          <a href="/research" class="nav-link <%= typeof page !== 'undefined' && page === 'research' ? 'active' : '' %>">Research</a>
          <a href="/skills" class="nav-link <%= typeof page !== 'undefined' && page === 'skills' ? 'active' : '' %>">Skills</a>
          <a href="/cv" class="nav-link <%= typeof page !== 'undefined' && page === 'cv' ? 'active' : '' %>">CV</a>
          <a href="/contact" class="nav-link <%= typeof page !== 'undefined' && page === 'contact' ? 'active' : '' %>">Contact</a>                  
        </div>
        
        <!-- Mobile Menu Button -->
        <div class="md:hidden">
          <button id="menuBtn" class="text-gray-light hover:text-white focus:outline-none">
            <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
          </button>
        </div>
      </div>
    </div>
  </nav>
  
  <!-- Mobile Menu -->
  <div id="mobileMenu" class="mobile-menu">
    <div class="flex flex-col space-y-4">
      <a href="/" class="nav-link text-lg <%= typeof page !== 'undefined' && page === 'home' ? 'active' : '' %>">Home</a>
      <a href="/about" class="nav-link text-lg <%= typeof page !== 'undefined' && page === 'about' ? 'active' : '' %>">About</a>
      <a href="/projects" class="nav-link text-lg <%= typeof page !== 'undefined' && page === 'projects' ? 'active' : '' %>">Projects</a>
      <a href="/research" class="nav-link text-lg <%= typeof page !== 'undefined' && page === 'research' ? 'active' : '' %>">Research</a>
      <a href="/skills" class="nav-link text-lg <%= typeof page !== 'undefined' && page === 'skills' ? 'active' : '' %>">Skills</a>
      <a href="/cv" class="nav-link text-lg <%= typeof page !== 'undefined' && page === 'cv' ? 'active' : '' %>">CV</a>
      <a href="/contact" class="nav-link text-lg <%= typeof page !== 'undefined' && page === 'contact' ? 'active' : '' %>">Contact</a>
    </div>
  </div>
